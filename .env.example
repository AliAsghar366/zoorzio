# Application
NODE_ENV=development
PORT=3000

# Database (see apps/api/.env.example for the Supabase pooled/direct URL format)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anchor_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/anchor_dev

# Redis
REDIS_URL=redis://localhost:6379

# Vercel Cron Jobs (see apps/api/vercel.json)
CRON_SECRET=your-long-random-cron-secret

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key-hex

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# WhatsApp
WHATSAPP_BUSINESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-token

# Email
SENDGRID_API_KEY=your-sendgrid-key

# Google Calendar
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Outlook Calendar
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret

# AWS
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# Monitoring
DATADOG_API_KEY=your-datadog-key
SENTRY_DSN=your-sentry-dsn
