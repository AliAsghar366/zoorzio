# Application
NODE_ENV=development
PORT=3000

# Database (see apps/api/.env.example for the Supabase pooled/direct URL format)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anchor_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/anchor_dev

# Redis
REDIS_URL=redis://localhost:6379

# This API's own public base URL. Required for "bring your own bot": it's the
# origin Telegram and Slack deliver each user's webhooks to, so it must be
# reachable from the internet (not localhost) in any deployed environment.
API_URL=http://localhost:3001/api

# Vercel Cron Jobs (see apps/api/vercel.json)
CRON_SECRET=your-long-random-cron-secret

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key-hex

# Grok / xAI - the primary chat provider for the AI service (apps/ai).
# Used server-side only; never expose this to the browser or to the model itself.
XAI_API_KEY=your-xai-api-key

# OpenAI - still required for embeddings, transcription (voice notes) and image
# description, which xAI does not provide. Also the chat fallback if XAI_API_KEY
# is unset.
OPENAI_API_KEY=your-openai-api-key

# Groq (distinct from Grok/xAI above) - optional last-resort chat fallback.
GROQ_API_KEY=your-groq-api-key

# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_BUSINESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
# App secret from the Meta app - inbound webhooks are rejected in production
# unless their X-Hub-Signature-256 verifies against this.
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
# Meta app id - used with WHATSAPP_APP_SECRET to exchange the Embedded Signup
# code when connecting the WhatsApp Business app number (admin > WhatsApp).
WHATSAPP_APP_ID=your-meta-app-id
# Graph API version for every WhatsApp call. Meta retires versions about two
# years after release, so keep this on a currently supported one.
WHATSAPP_GRAPH_API_VERSION=v25.0
# Approved message template for reminders that fire more than 24 hours after
# the user last messaged Zoorzio - WhatsApp rejects anything else then.
# Submit it with: npm run whatsapp:template -- create
WHATSAPP_REMINDER_TEMPLATE_NAME=zoorzio_reminder
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=en

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-token

# Email
SENDGRID_API_KEY=your-sendgrid-key

# Google - one OAuth client covers Calendar and Gmail (the consent screen asks
# for calendar + gmail.send + gmail.readonly together).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/oauth/google/callback

# Outlook Calendar
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret

# AWS
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# Monitoring
DATADOG_API_KEY=your-datadog-key
SENTRY_DSN=your-sentry-dsn
