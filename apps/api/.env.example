# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Database
# Local dev:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anchor_dev
# Supabase (Project Settings -> Database -> Connection string):
#   DATABASE_URL - "Transaction" pooler, port 6543, for the running app (serverless-safe)
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL   - direct connection, port 5432, used only by `prisma migrate deploy`/`db push`
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/anchor_dev

# Redis (use a serverless-friendly provider like Upstash if deploying the API to Vercel)
REDIS_URL=redis://localhost:6379

# Vercel Cron Jobs (see apps/api/vercel.json) - Vercel auto-sends
# `Authorization: Bearer <CRON_SECRET>` to /api/cron/* when this is set on
# the project. Generate with: openssl rand -hex 32
CRON_SECRET=your-long-random-cron-secret

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key-hex

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# WhatsApp Business
WHATSAPP_BUSINESS_TOKEN=your-whatsapp-business-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_BUSINESS_PHONE_NUMBER=your-dialable-business-number

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username

# SMS via Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token

# Slack
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Productivity integrations hub
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:3005/api/integrations/github/callback

NOTION_CLIENT_ID=your-notion-integration-client-id
NOTION_CLIENT_SECRET=your-notion-integration-client-secret
NOTION_REDIRECT_URI=http://localhost:3005/api/integrations/notion/callback

GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:3005/api/integrations/google_workspace/callback

SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret
SLACK_TEAM_REDIRECT_URI=http://localhost:3005/api/integrations/slack/callback

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@anchor.app

# Google Calendar OAuth (console.cloud.google.com - enable the Calendar API,
# register the redirect URI below as an authorized redirect URI)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3005/api/calendar/google/callback

# Outlook Calendar OAuth (portal.azure.com app registration - Microsoft Graph
# "Calendars.ReadWrite" + "offline_access" delegated permissions, register the
# redirect URI below as a Web platform redirect URI)
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:3005/api/calendar/outlook/callback

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=anchor-storage-dev

# Monitoring
DATADOG_API_KEY=your-datadog-api-key
SENTRY_DSN=your-sentry-dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
