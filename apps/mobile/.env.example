# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_APP_NAME=Zoorzio

# Authentication
EXPO_PUBLIC_AUTH_ENABLED=true

# Feature Flags
EXPO_PUBLIC_ENABLE_WHATSAPP=true
EXPO_PUBLIC_ENABLE_TELEGRAM=true
EXPO_PUBLIC_ENABLE_CALENDAR=true
EXPO_PUBLIC_ENABLE_VOICE=true
EXPO_PUBLIC_ENABLE_CAMERA=true

# Push Notifications
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true

# Analytics
EXPO_PUBLIC_ANALYTICS_ID=

# Error Tracking
EXPO_PUBLIC_SENTRY_DSN=

# Deep Linking
EXPO_PUBLIC_DEEP_LINK_SCHEME=anchor
