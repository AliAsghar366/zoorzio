# Application
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Production (Vercel project env var): point this at the deployed Railway API
# instead, e.g. https://<your-railway-app>.up.railway.app/api
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Anchor

# Authentication
NEXT_PUBLIC_AUTH_ENABLED=true

# Feature Flags
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_TELEGRAM=true
NEXT_PUBLIC_ENABLE_CALENDAR=true
NEXT_PUBLIC_ENABLE_VOICE=true

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=

# Error Tracking
NEXT_PUBLIC_SENTRY_DSN=

# WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:3000
