{
  "name": "anchor",
  "version": "1.0.0",
  "description": "The memory layer that actually remembers",
  "author": "Anchor Team",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:ai\"",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:ai": "cd apps/ai && python main.py",
    "dev:mobile": "cd apps/mobile && npm start",
    "build": "npm run build:packages && npm run build:api && npm run build:web",
    "build:packages": "npm run build --workspace=@anchor/shared && npm run build --workspace=@anchor/ui",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "test": "npm run test:api && npm run test:web && npm run test:ai",
    "test:api": "cd apps/api && npm run test",
    "test:web": "cd apps/web && npm run test",
    "test:ai": "cd apps/ai && python -m pytest tests/",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "cd apps/api && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "format": "npm run format:api && npm run format:web",
    "format:api": "cd apps/api && npm run format",
    "format:web": "cd apps/web && npm run format",
    "db:generate": "npm run generate --workspace=@anchor/database",
    "db:migrate": "npm run migrate:dev --workspace=@anchor/database",
    "migration:run": "npm run migrate:deploy --workspace=@anchor/database",
    "db:seed": "npm run seed --workspace=@anchor/database",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "prepare": "husky install"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "rxjs": "^7.8.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "husky": "^9.0.6",
    "ioredis": "^6.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "redis-memory-server": "^0.17.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
